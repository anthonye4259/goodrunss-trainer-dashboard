// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CLIENT) // NEW: Support both trainers and clients
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Trainer-specific fields (null for clients)
  bio            String?
  specialties    String[]
  certifications String[]
  hourlyRate     Float?
  phone          String?
  location       String? // Text address (e.g., "New York, NY")
  isAvailable    Boolean  @default(true) // NEW: Trainer availability status
  rating         Float? // NEW: Average rating
  totalSessions  Int      @default(0) // NEW: Session count

  // Geolocation fields (for both trainers and clients)
  latitude          Float? // GPS latitude
  longitude         Float? // GPS longitude
  locationEnabled   Boolean   @default(false) // Privacy: Allow location sharing
  locationUpdatedAt DateTime? // Last location update
  address           String? // Formatted address from geocoding
  city              String? // City name
  state             String? // State/Province
  country           String?   @default("US") // Country code
  postalCode        String? // ZIP/Postal code

  // Relationships
  clients           Client[] // Clients created by trainer
  trainerSessions   TrainerSession[] @relation("TrainerSessions") // Sessions as trainer
  clientBookings    TrainerSession[] @relation("ClientBookings") // NEW: Sessions as client
  paymentsAsTrainer Payment[]        @relation("TrainerPayments") // Payments received
  paymentsAsClient  Payment[]        @relation("ClientPayments") // NEW: Payments made
  analytics         Analytics[]
  reviews           Review[]         @relation("TrainerReviews") // NEW: Reviews received
  givenReviews      Review[]         @relation("ClientReviews") // NEW: Reviews given
  viralContent      ViralContent[]   @relation("ViralContent") // NEW: Viral content
  sentMessages      Message[]        @relation("SentMessages") // NEW: Messages sent
  receivedMessages          Message[]                @relation("ReceivedMessages") // NEW: Messages received
  scheduledNotifications    ScheduledNotification[]  @relation("ScheduledNotificationsByTrainer") // Notifications scheduled by trainer
  receivedScheduledNotifications ScheduledNotification[]  @relation("ScheduledNotificationsForClient") // Notifications scheduled for client
  
  // Public booking system (pre-app launch)
  bookingSettings    BookingSettings?   @relation("TrainerBookingSettings")
  publicBookings     PublicBooking[]    @relation("TrainerPublicBookings")

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  age       Int?
  goals     String[]
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  trainerId String
  trainer   User             @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  sessions  TrainerSession[]
  payments  Payment[]

  @@map("clients")
}

model TrainerSession {
  id          String        @id @default(cuid())
  title       String
  description String?
  type        SessionType
  duration    Int // in minutes
  scheduledAt DateTime
  status      SessionStatus @default(SCHEDULED)
  notes       String?
  bookedFrom  BookingSource @default(DASHBOARD) // NEW: Track booking source
  location    String? // NEW: Session location
  meetingLink String? // NEW: Virtual meeting link
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relationships
  trainerId String
  trainer   User   @relation("TrainerSessions", fields: [trainerId], references: [id], onDelete: Cascade)

  // Support both legacy Client model AND new User-based clients
  clientId String? // Legacy Client model
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  appClientId String? // NEW: User ID from consumer app
  appClient   User?   @relation("ClientBookings", fields: [appClientId], references: [id], onDelete: SetNull)

  payment Payment?

  @@map("trainer_sessions")
}

model Payment {
  id              String        @id @default(cuid())
  amount          Float
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod
  description     String?
  paidAt          DateTime?
  stripePaymentId String? // Stripe payment intent ID
  stripeChargeId  String? // Stripe charge ID
  stripeFee       Float? // Stripe fee amount
  platformFee     Float? // GoodRunss platform fee
  trainerPayout   Float? // Amount trainer receives
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships - Trainer receives payment
  trainerId String
  trainer   User   @relation("TrainerPayments", fields: [trainerId], references: [id], onDelete: Cascade)

  // Legacy Client model
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // App user who made payment
  appClientId String?
  appClient   User?   @relation("ClientPayments", fields: [appClientId], references: [id], onDelete: SetNull)

  sessionId String?         @unique
  session   TrainerSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Refund relationship
  refund Refund?

  @@map("payments")
}

// Stripe Connect accounts for trainers
model StripeAccount {
  id              String   @id @default(uuid())
  userId          String   @unique // Trainer user ID

  // Stripe account info
  stripeAccountId String   @unique
  accountType     String   @default("express") // express, standard, custom

  // Onboarding status
  detailsSubmitted Boolean  @default(false)
  chargesEnabled   Boolean  @default(false)
  payoutsEnabled   Boolean  @default(false)

  // Requirements
  currentlyDue     String[] // Fields currently due
  eventuallyDue    String[] // Fields eventually due
  pastDue          String[] // Fields past due
  pendingVerification String[] // Fields pending verification

  // Account details
  email           String?
  country         String?
  defaultCurrency String?

  // Payout schedule
  payoutSchedule  Json? // { interval: 'daily', delay_days: 2 }

  // Business profile
  businessName    String?
  businessUrl     String?
  supportPhone    String?
  supportEmail    String?

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([stripeAccountId])
  @@map("stripe_accounts")
}

// Payment refunds
model Refund {
  id              String   @id @default(uuid())
  paymentId       String   @unique
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // Refund details
  amount          Float
  currency        String
  reason          String? // duplicate, fraudulent, requested_by_customer
  status          String   @default("pending") // pending, succeeded, failed, canceled

  // Stripe info
  stripeRefundId  String?

  // Who initiated
  initiatedBy     String // userId
  initiatedAt     DateTime @default(now())

  // Processing
  processedAt     DateTime?
  failureReason   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

// Payment intents (for tracking payment flow)
model PaymentIntent {
  id              String   @id @default(uuid())

  // Stripe payment intent
  stripeIntentId  String   @unique

  // Payment details
  amount          Float
  currency        String
  status          String // requires_payment_method, requires_confirmation, processing, succeeded, canceled

  // Parties
  userId          String // Player/client
  trainerId       String // Trainer
  sessionId       String? // Training session

  // Metadata
  metadata        Json?

  // Client secret (for frontend)
  clientSecret    String

  // Payment method
  paymentMethodId String?

  // Created
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime // Payment intents expire after 24h

  @@index([stripeIntentId])
  @@index([userId])
  @@index([trainerId])
  @@index([status])
  @@map("payment_intents")
}

model Analytics {
  id        String   @id @default(cuid())
  date      DateTime
  metric    String // e.g., "revenue", "sessions", "clients"
  value     Float
  metadata  Json? // Additional data
  createdAt DateTime @default(now())

  // Relationships
  trainerId String
  trainer   User   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("analytics")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5 stars
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  trainerId String
  trainer   User   @relation("TrainerReviews", fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)

  sessionId String?

  @@map("reviews")
}

enum SessionType {
  PERSONAL_TRAINING
  GROUP_FITNESS
  NUTRITION_COACHING
  ONLINE_COACHING
  WORKOUT_PLAN
  ASSESSMENT
}

enum SessionStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  DIGITAL_WALLET
  CHECK
}

enum UserRole {
  CLIENT // Consumer app user who books trainers
  TRAINER // Trainer who provides services
  ADMIN // Admin with full access
}

enum BookingSource {
  APP // Booked via consumer mobile app
  DASHBOARD // Booked via trainer dashboard
  WEB // Booked via public website
  API // Booked via external API
}

// Messaging Model for trainer-client communication
model Message {
  id          String      @id @default(uuid())
  senderId    String
  receiverId  String
  content     String      @db.Text
  messageType MessageType @default(TEXT)
  read        Boolean     @default(false)
  readAt      DateTime?
  sessionId   String? // Optional: Link to training session
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("messages")
}

enum MessageType {
  TEXT // Plain text message
  IMAGE // Image attachment
  FILE // File attachment
  SYSTEM // System notification
}

// Viral Growth Models
model ViralContent {
  id          String   @id @default(uuid())
  userId      String
  contentType String // 'marketing_generation', 'qr_code', 'widget', 'workout_recap', 'gia_workout_share', 'workout_share'
  contentData Json
  shareCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("ViralContent", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contentType])
  @@map("viral_content")
}

model ReferralTracking {
  id            String   @id @default(uuid())
  referrerId    String?
  referredEmail String
  source        String // 'instagram', 'tiktok', 'twitter', 'facebook', 'qr_code', 'widget'
  referralCode  String
  converted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([referrerId])
  @@index([referralCode])
  @@index([converted])
  @@map("referral_tracking")
}

model ViralMetrics {
  id           String   @id @default(uuid())
  userId       String
  metricType   String // 'share', 'click', 'conversion', 'engagement'
  platform     String // 'instagram', 'tiktok', 'twitter', 'facebook', 'qr_code', 'widget'
  contentId    String?
  referralCode String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([metricType])
  @@index([platform])
  @@map("viral_metrics")
}

model GiaContent {
  id               String   @id @default(uuid())
  userId           String
  contentType      String // 'marketing', 'workout_plan', 'social_post', 'email_template'
  prompt           String   @db.Text
  generatedContent Json
  usageCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([contentType])
  @@map("gia_content")
}

// A/B Testing Models
model AbTest {
  id           String             @id @default(uuid())
  name         String             @unique
  description  String?            @db.Text
  versions     Json // Array of { id, content, weight }
  targetMetric String
  trafficSplit Int                @default(50)
  status       String             @default("ACTIVE")
  winner       String?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignments  AbTestAssignment[]
  conversions  AbTestConversion[]
  results      AbTestResult[]

  @@index([name])
  @@index([status])
  @@map("ab_tests")
}

model AbTestAssignment {
  id         String   @id @default(uuid())
  testName   String
  userId     String
  variant    String // 'A', 'B', 'C', etc.
  assignedAt DateTime @default(now())
  test       AbTest   @relation(fields: [testName], references: [name], onDelete: Cascade)

  @@unique([testName, userId])
  @@index([testName])
  @@index([userId])
  @@index([variant])
  @@map("ab_test_assignments")
}

model AbTestConversion {
  id             String   @id @default(uuid())
  testName       String
  userId         String
  variant        String // 'A', 'B', 'C', etc.
  action         String
  isTargetMetric Boolean  @default(false)
  metadata       Json?
  convertedAt    DateTime @default(now())
  test           AbTest   @relation(fields: [testName], references: [name], onDelete: Cascade)

  @@index([testName])
  @@index([userId])
  @@index([variant])
  @@index([action])
  @@index([isTargetMetric])
  @@map("ab_test_conversions")
}

model AbTestResult {
  id               String   @id @default(uuid())
  testName         String
  variant          String
  totalAssignments Int      @default(0)
  totalConversions Int      @default(0)
  conversionRate   Decimal  @default(0)
  lift             Decimal  @default(0)
  isWinner         Boolean  @default(false)
  calculatedAt     DateTime @default(now())
  test             AbTest   @relation(fields: [testName], references: [name], onDelete: Cascade)

  @@unique([testName, variant])
  @@index([testName])
  @@index([variant])
  @@map("ab_test_results")
}

// Premium Subscription & Trial
model PremiumSubscription {
  id                   String    @id @default(uuid())
  userId               String    @unique
  plan                 String    @default("PREMIUM") // PREMIUM, BASIC, FREE
  status               String    @default("ACTIVE") // ACTIVE, CANCELED, EXPIRED
  startDate            DateTime  @default(now())
  endDate              DateTime?
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("premium_subscriptions")
}

model PremiumTrial {
  id        String   @id @default(uuid())
  userId    String   @unique
  startDate DateTime @default(now())
  endDate   DateTime
  status    String   @default("ACTIVE") // ACTIVE, USED, EXPIRED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("premium_trials")
}

// Email Logging for Resend Integration
model EmailLog {
  id             String    @id @default(uuid())
  emailType      String // 'booking_confirmation', 'payment_receipt'
  recipientEmail String
  subject        String?   @db.Text
  status         String    @default("pending") // 'pending', 'sent', 'failed'
  metadata       Json?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([emailType])
  @@index([recipientEmail])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

// AI Persona Models - Trainers create AI clones of themselves
model AiPersona {
  id        String @id @default(uuid())
  trainerId String @unique // One persona per trainer

  // Basic Info
  name      String
  tagline   String? @db.Text
  bio       String? @db.Text
  avatarUrl String?

  // Voice & Video
  voiceFileUrl    String?
  voiceSampleText String? @db.Text
  videoUrl        String?

  // Teaching Style & Traits
  teachingStyle  String   @default("motivational") // motivational, technical, gentle, tough_love
  personality    Json // { motivational: 8, empathetic: 7, technical: 9, humorous: 5 }
  specialties    String[] // ["strength_training", "cardio", "nutrition"]
  certifications String[]

  // Pricing & Availability
  pricePerSession Decimal @default(0.30) // $0.30 per session
  isActive        Boolean @default(false) // Published/unpublished
  isDiscoverable  Boolean @default(true) // Show in marketplace

  // Stats
  totalSessions Int      @default(0)
  totalEarnings Decimal  @default(0)
  averageRating Decimal? @default(0)
  totalRatings  Int      @default(0)

  // ElevenLabs Integration
  elevenLabsVoiceId  String? // ElevenLabs voice model ID
  elevenLabsModelUrl String?

  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Relations
  sessions AiPersonaSession[]
  feedback AiPersonaFeedback[]
  earnings AiPersonaEarning[]

  @@index([trainerId])
  @@index([isActive])
  @@index([isDiscoverable])
  @@map("ai_personas")
}

// Track each time a player uses an AI persona
model AiPersonaSession {
  id        String @id @default(uuid())
  personaId String
  playerId  String // Consumer app user ID

  // Session Details
  duration         Int // Duration in minutes
  messageCount     Int   @default(0)
  conversationData Json? // Store conversation for analysis

  // Pricing
  cost            Decimal @default(0.30) // Cost per session
  trainerEarnings Decimal @default(0.30) // Amount trainer earns

  // Payment
  paymentStatus   String    @default("pending") // pending, completed, failed
  stripePaymentId String?
  paidAt          DateTime?

  // Metadata
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  // Relations
  persona AiPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId])
  @@index([playerId])
  @@index([paymentStatus])
  @@index([startedAt])
  @@map("ai_persona_sessions")
}

// Player feedback on AI personas
model AiPersonaFeedback {
  id        String  @id @default(uuid())
  personaId String
  playerId  String // Consumer app user ID
  sessionId String? // Optional link to session

  // Feedback
  rating         Int // 1-5 stars
  comment        String?  @db.Text
  isHelpful      Boolean? // Was the AI helpful?
  accuracyRating Int? // How accurate to real trainer (1-5)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  persona AiPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId])
  @@index([playerId])
  @@index([rating])
  @@map("ai_persona_feedback")
}

// Track earnings over time for analytics
model AiPersonaEarning {
  id        String @id @default(uuid())
  personaId String
  trainerId String

  // Earnings Details
  amount       Decimal  @default(0.30)
  sessionCount Int      @default(1)
  date         DateTime @default(now())

  // Payout Status
  payoutStatus String    @default("pending") // pending, processing, paid
  payoutId     String? // Stripe payout ID
  paidAt       DateTime?

  // Metadata
  createdAt DateTime @default(now())

  // Relations
  persona AiPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId])
  @@index([trainerId])
  @@index([date])
  @@index([payoutStatus])
  @@map("ai_persona_earnings")
}

// ========================================
// BOOKING WAITLIST SYSTEM
// ========================================

// Players can join a waitlist when a trainer is fully booked
model BookingWaitlist {
  id        String @id @default(uuid())
  trainerId String
  playerId  String

  // Desired booking details
  desiredDate     DateTime? // Preferred date (optional)
  desiredTimeSlot String? // morning, afternoon, evening, flexible
  sessionType     String? // Type of session they want
  duration        Int       @default(60) // Minutes

  // Status
  status   String @default("active") // active, notified, booked, cancelled, expired
  priority Int    @default(0) // Higher priority gets notified first

  // Notifications
  notifiedAt DateTime?
  bookedAt   DateTime?
  expiresAt  DateTime? // Auto-expire after X days

  // Contact
  playerEmail    String
  playerPhone    String?
  notifyViaSMS   Boolean @default(false)
  notifyViaEmail Boolean @default(true)
  notifyViaPush  Boolean @default(true)

  // Notes
  notes String? @db.Text

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerId])
  @@index([playerId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("booking_waitlist")
}

// Track waitlist notifications sent
model WaitlistNotification {
  id         String @id @default(uuid())
  waitlistId String
  trainerId  String
  playerId   String

  // Notification details
  notificationType String // email, sms, push
  sentAt           DateTime  @default(now())
  opened           Boolean   @default(false)
  openedAt         DateTime?

  // Available slot details
  availableDate DateTime?
  availableSlot String?

  // Response
  responded   Boolean   @default(false)
  respondedAt DateTime?
  booked      Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([waitlistId])
  @@index([trainerId])
  @@index([playerId])
  @@index([sentAt])
  @@map("waitlist_notifications")
}

// ========================================
// SCHEDULED NOTIFICATIONS
// ========================================

// Schedule notifications to be sent at a future time
model ScheduledNotification {
  id        String   @id @default(uuid())
  trainerId String
  clientId  String
  
  // Notification details
  type   String // booking_reminder, payment_due, custom, etc.
  params Json // Parameters for the notification template
  
  // Schedule
  scheduledFor DateTime
  sentAt       DateTime?
  cancelledAt  DateTime?
  
  // Status
  status String @default("pending") // pending, sent, failed, cancelled
  error  String?
  
  // Recurring
  isRecurring         Boolean   @default(false)
  recurringFrequency  String? // daily, weekly, monthly
  recurringEndDate    DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  trainer User @relation("ScheduledNotificationsByTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("ScheduledNotificationsForClient", fields: [clientId], references: [id], onDelete: Cascade)
  
  @@index([trainerId])
  @@index([clientId])
  @@index([scheduledFor])
  @@index([status])
  @@map("scheduled_notifications")
}

// ========================================
// ADAPTIVE FEED ALGORITHM (TikTok-style)
// ========================================

// Track every user interaction for personalization
model UserInteraction {
  id     String @id @default(uuid())
  userId String

  // Content Info
  contentType String // trainer, facility, workout, ai_persona, video, post
  contentId   String

  // Interaction Type
  action      String // view, like, skip, share, bookmark, book, watch, complete
  actionValue Float? // Duration watched (seconds), completion %, etc.

  // Context
  sessionId  String? // Group actions in same session
  deviceType String? // mobile, tablet, web
  location   Json? // { lat, lng, city }
  timeOfDay  String? // morning, afternoon, evening, night
  dayOfWeek  Int? // 0-6

  // Metadata
  metadata  Json? // Additional context
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([contentType, contentId])
  @@index([action])
  @@index([sessionId])
  @@index([createdAt])
  @@map("user_interactions")
}

// Store computed user preferences (updated by ML algorithm)
model UserPreference {
  id     String @id @default(uuid())
  userId String @unique

  // Workout Preferences
  workoutTypes   Json // { strength: 0.8, cardio: 0.6, yoga: 0.3 }
  intensityLevel String @default("medium") // beginner, medium, advanced, mixed

  // Trainer Preferences
  trainerStyles Json // { motivational: 0.9, technical: 0.7, gentle: 0.2 }
  trainerIds    String[] // Favorite trainers

  // Content Preferences
  videoLength    String @default("medium") // short, medium, long, mixed
  contentFormats Json // { video: 0.9, audio: 0.5, text: 0.3 }

  // Specialty Preferences
  specialties Json // { weight_loss: 0.8, muscle_gain: 0.6, flexibility: 0.4 }

  // Time Preferences
  preferredTimes String[] // morning, afternoon, evening
  preferredDays  Int[] // 0-6 (0=Sunday)

  // Location Preferences
  maxDistance    Float? // Max distance willing to travel (miles)
  preferredAreas String[] // City names or zip codes

  // Engagement Scores
  engagementScore Float @default(0) // Overall engagement (0-1)
  skipRate        Float @default(0) // How often they skip content (0-1)
  bookingRate     Float @default(0) // Conversion to bookings (0-1)

  // Algorithm Version
  modelVersion String   @default("v1")
  lastComputed DateTime @default(now())

  // Metadata
  totalInteractions Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([engagementScore])
  @@index([lastComputed])
  @@map("user_preferences")
}

// Tag all content with features for recommendation
model ContentFeature {
  id String @id @default(uuid())

  // Content Info
  contentType String // trainer, facility, workout, ai_persona, video
  contentId   String

  // Features
  workoutType String? // strength, cardio, yoga, hiit, etc.
  intensity   String? // beginner, intermediate, advanced
  duration    Int? // Duration in minutes
  specialty   String[] // weight_loss, muscle_gain, flexibility
  equipment   String[] // dumbbells, resistance_bands, none

  // Trainer/Creator Features
  trainerId    String?
  trainerStyle String? // motivational, technical, gentle, tough_love

  // Location
  location Json? // { lat, lng, city, state }

  // Popularity Metrics
  viewCount    Int @default(0)
  likeCount    Int @default(0)
  bookingCount Int @default(0)
  shareCount   Int @default(0)

  // Quality Scores
  completionRate  Float @default(0) // How often people finish it
  engagementScore Float @default(0) // Overall engagement
  rating          Float @default(0) // Average rating

  // Recency
  publishedAt DateTime?
  lastUpdated DateTime  @default(now())

  // Metadata
  tags      String[]
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentType, contentId])
  @@index([contentType])
  @@index([workoutType])
  @@index([intensity])
  @@index([trainerId])
  @@index([engagementScore])
  @@index([publishedAt])
  @@map("content_features")
}

// Cache recommendation scores for performance
model RecommendationScore {
  id     String @id @default(uuid())
  userId String

  // Content Info
  contentType String
  contentId   String

  // Scores
  personalScore   Float // Personalization score (0-1)
  popularityScore Float // Global popularity (0-1)
  recencyScore    Float // How recent (0-1)
  diversityScore  Float // Diversity bonus (0-1)
  finalScore      Float // Combined score (0-1)

