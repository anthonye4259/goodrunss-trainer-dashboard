model gia_programs {
  id               String   @id
  instructorId     String
  title            String
  description      String?
  type             String   // 'lesson_plan', 'workout_program', 'class_sequence', 'drill_progression'
  sportCategory    String?  // 'pickleball', 'yoga', 'tennis', 'pilates', 'performance', etc.
  difficultyLevel  String?  // 'beginner', 'intermediate', 'advanced'
  durationMinutes  Int?
  content          Json     // Structured program data
  giaPrompt        String?  // Original prompt
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isFavorite       Boolean  @default(false)
  timesUsed        Int      @default(0)
  
  instructor       users    @relation("InstructorPrograms", fields: [instructorId], references: [id], onDelete: Cascade)
  usage            gia_program_usage[]

  @@index([instructorId])
  @@index([type])
  @@index([sportCategory])
  @@index([createdAt(sort: Desc)])
}

model gia_program_usage {
  id           String   @id
  programId    String
  instructorId String
  studentId    String?
  usedAt       DateTime @default(now())
  feedback     String?
  rating       Int?     // 1-5 stars
  
  program      gia_programs @relation(fields: [programId], references: [id], onDelete: Cascade)
  instructor   users        @relation("InstructorProgramUsage", fields: [instructorId], references: [id], onDelete: Cascade)
  student      users?       @relation("StudentProgramUsage", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([instructorId])
}

enum GiaProgramType {
  LESSON_PLAN
  WORKOUT_PROGRAM
  CLASS_SEQUENCE
  DRILL_PROGRESSION
}

// Ambassador Program Tables
model ambassadors {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String?  @unique  // Made optional for public signups
  email             String?  @unique  // For non-user ambassadors
  name              String?             // Ambassador's name
  referralCode      String   @unique
  isActive          Boolean  @default(true)
  totalEarnings     Decimal  @default(0) @db.Decimal(10, 2)
  pendingEarnings   Decimal  @default(0) @db.Decimal(10, 2)
  paidEarnings      Decimal  @default(0) @db.Decimal(10, 2)
  totalReferrals    Int      @default(0)
  activeReferrals   Int      @default(0)
  payoutMethod      String?  @default("PAYPAL") // PAYPAL, BANK_ACCOUNT, STRIPE
  payoutEmail       String?             // PayPal email
  bankAccountLast4  String?             // Last 4 of bank account
  stripeAccountId   String?             // Stripe Connect account ID
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  users             users?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals         referrals[]
  commissions       commissions[]
  payouts           payouts[]
  
  @@index([userId])
  @@index([email])
  @@index([referralCode])
  @@index([isActive])
}

model referrals {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  ambassadorId      String
  referredUserId    String   @unique
  referralCode      String
  status            ReferralStatus @default(PENDING)
  convertedAt       DateTime?
  firstPaymentAt    DateTime?
  createdAt         DateTime @default(now())
  
  ambassador        ambassadors @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referredUser      users    @relation(fields: [referredUserId], references: [id], onDelete: Cascade)
  commissions       commissions[]
  
  @@index([ambassadorId])
  @@index([referredUserId])
  @@index([referralCode])
  @@index([status])
}

model commissions {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  ambassadorId      String
  referralId        String
  amount            Decimal  @db.Decimal(10, 2)
  type              CommissionType
  status            CommissionStatus @default(PENDING)
  paymentId         String?
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  
  ambassador        ambassadors @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referral          referrals @relation(fields: [referralId], references: [id], onDelete: Cascade)
  
  @@index([ambassadorId])
  @@index([referralId])
  @@index([status])
  @@index([type])
}

model payouts {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  ambassadorId      String
  amount            Decimal  @db.Decimal(10, 2)
  status            PayoutStatus @default(PENDING)
  method            String?
  transactionId     String?
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  
  ambassador        ambassadors @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  
  @@index([ambassadorId])
  @@index([status])
}

enum ReferralStatus {
  PENDING
  CONVERTED
  ACTIVE
  CHURNED
}

enum CommissionType {
  FIRST_MONTH    // 50%
  RECURRING      // 10%
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Community & High-Status Features Schema

enum TrainerTier {
  MEMBER    // Default
  PRO       // $5k+ monthly revenue
  ELITE     // $10k+ monthly revenue
  LEGEND    // $25k+ monthly revenue
}

model trainer_profiles {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String   @unique
  bio               String?
  specialties       String[] @default([])
  certifications    String[] @default([])
  yearsExperience   Int?
  instagramHandle   String?
  tiktokHandle      String?
  youtubeChannel    String?
  websiteUrl        String?
  tier              TrainerTier @default(MEMBER)
  badges            String[] @default([]) // VERIFIED, TOP_10, FIVE_STAR, TRENDING, etc.
  isVerified        Boolean  @default(false)
  profilePhotoUrl   String?
  coverPhotoUrl     String?
  location          String?
  hourlyRate        Float?
  monthlyRevenue    Decimal  @default(0) @db.Decimal(10, 2)
  totalClients      Int      @default(0)
  activeClients     Int      @default(0)
  averageRating     Float?
  totalReviews      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  success_stories   success_stories[]
  
  @@index([userId])
  @@index([tier])
  @@index([isVerified])
  @@index([monthlyRevenue])
}

model success_stories {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  trainerId       String
  trainerProfileId String
  clientName      String
  beforePhotoUrl  String?
  afterPhotoUrl   String?
  beforeVideoUrl  String?
  afterVideoUrl   String?
  testimonial     String
  metrics         Json?    // { weightLost: 20, prsHit: 5, etc. }
  timeframe       String?  // "3 months", "6 weeks", etc.
  isPublic        Boolean  @default(true)
  likes           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  trainer_profile trainer_profiles @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  
  @@index([trainerProfileId])
  @@index([isPublic])
  @@index([createdAt])
}

model community_posts {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  trainerId   String
  type        String   // SUCCESS_STORY, TIP, MILESTONE, QUESTION
  title       String?
  content     String
  mediaUrls   String[] @default([])
  likes       Int      @default(0)
  comments    Int      @default(0)
  views       Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([trainerId])
  @@index([type])
  @@index([createdAt])
  @@index([likes])
}
