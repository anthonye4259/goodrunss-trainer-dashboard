  @@unique([userId, contentType, contentId])
  @@index([userId])
  @@index([finalScore])
  @@index([expiresAt])
  @@index([computedAt])
  @@map("recommendation_scores")
}

// Track feed sessions for analytics
model FeedSession {
  id     String @id @default(uuid())
  userId String

  // Session Info
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  duration  Int? // Seconds

  // Content Served
  contentServed  Int @default(0) // How many items shown
  contentViewed  Int @default(0) // How many viewed
  contentLiked   Int @default(0)
  contentSkipped Int @default(0)
  contentBooked  Int @default(0)

  // Algorithm Performance
  algorithmVersion String @default("v1")
  avgTimePerItem   Float? // Average seconds per item
  skipRate         Float? // Items skipped / items shown
  engagementRate   Float? // Items interacted / items shown

