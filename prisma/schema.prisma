generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ab_test_assignments {
  id         String   @id
  testName   String
  userId     String
  variant    String
  assignedAt DateTime @default(now())
  ab_tests   ab_tests @relation(fields: [testName], references: [name], onDelete: Cascade)

  @@unique([testName, userId])
  @@index([testName])
  @@index([userId])
  @@index([variant])
}

model ab_test_conversions {
  id             String   @id
  testName       String
  userId         String
  variant        String
  action         String
  isTargetMetric Boolean  @default(false)
  metadata       Json?
  convertedAt    DateTime @default(now())
  ab_tests       ab_tests @relation(fields: [testName], references: [name], onDelete: Cascade)

  @@index([action])
  @@index([isTargetMetric])
  @@index([testName])
  @@index([userId])
  @@index([variant])
}

model ab_test_results {
  id               String   @id
  testName         String
  variant          String
  totalAssignments Int      @default(0)
  totalConversions Int      @default(0)
  conversionRate   Decimal  @default(0)
  lift             Decimal  @default(0)
  isWinner         Boolean  @default(false)
  calculatedAt     DateTime @default(now())
  ab_tests         ab_tests @relation(fields: [testName], references: [name], onDelete: Cascade)

  @@unique([testName, variant])
  @@index([testName])
  @@index([variant])
}

model ab_tests {
  id                  String                @id
  name                String                @unique
  description         String?
  versions            Json
  targetMetric        String
  trafficSplit        Int                   @default(50)
  status              String                @default("ACTIVE")
  winner              String?
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  ab_test_assignments ab_test_assignments[]
  ab_test_conversions ab_test_conversions[]
  ab_test_results     ab_test_results[]

  @@index([name])
  @@index([status])
}

model accounts {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model ai_persona_earnings {
  id           String      @id
  personaId    String
  trainerId    String
  amount       Decimal     @default(0.30)
  sessionCount Int         @default(1)
  date         DateTime    @default(now())
  payoutStatus String      @default("pending")
  payoutId     String?
  paidAt       DateTime?
  createdAt    DateTime    @default(now())
  ai_personas  ai_personas @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([payoutStatus])
  @@index([personaId])
  @@index([trainerId])
}

model ai_persona_feedback {
  id             String      @id
  personaId      String
  playerId       String
  sessionId      String?
  rating         Int
  comment        String?
  isHelpful      Boolean?
  accuracyRating Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  ai_personas    ai_personas @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId])
  @@index([playerId])
  @@index([rating])
}

model ai_persona_sessions {
  id               String      @id
  personaId        String
  playerId         String
  duration         Int
  messageCount     Int         @default(0)
  conversationData Json?
  cost             Decimal     @default(0.30)
  trainerEarnings  Decimal     @default(0.30)
  paymentStatus    String      @default("pending")
  stripePaymentId  String?
  paidAt           DateTime?
  startedAt        DateTime    @default(now())
  endedAt          DateTime?
  createdAt        DateTime    @default(now())
  ai_personas      ai_personas @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([paymentStatus])
  @@index([personaId])
  @@index([playerId])
  @@index([startedAt])
}

model ai_personas {
  id                  String                @id
  trainerId           String                @unique
  name                String
  tagline             String?
  bio                 String?
  avatarUrl           String?
  voiceFileUrl        String?
  voiceSampleText     String?
  videoUrl            String?
  teachingStyle       String                @default("motivational")
  personality         Json
  specialties         String[]
  certifications      String[]
  pricePerSession     Decimal               @default(0.30)
  isActive            Boolean               @default(false)
  isDiscoverable      Boolean               @default(true)
  totalSessions       Int                   @default(0)
  totalEarnings       Decimal               @default(0)
  averageRating       Decimal?              @default(0)
  totalRatings        Int                   @default(0)
  elevenLabsVoiceId   String?
  elevenLabsModelUrl  String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  publishedAt         DateTime?
  ai_persona_earnings ai_persona_earnings[]
  ai_persona_feedback ai_persona_feedback[]
  ai_persona_sessions ai_persona_sessions[]

  @@index([isActive])
  @@index([isDiscoverable])
  @@index([trainerId])
}

model analytics {
  id        String   @id
  date      DateTime
  metric    String
  value     Float
  metadata  Json?
  createdAt DateTime @default(now())
  trainerId String
  users     users    @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

model anonymous_sessions {
  id                     String    @id
  sessionToken           String    @unique
  deviceId               String?
  deviceType             String?
  tempEmail              String?
  tempPhone              String?
  hasCompletedOnboarding Boolean   @default(false)
  onboardingStep         Int       @default(0)
  onboardingData         Json?
  totalInteractions      Int       @default(0)
  contentViewed          Int       @default(0)
  timeSpent              Int       @default(0)
  lastActiveAt           DateTime  @default(now())
  convertedToUserId      String?
  convertedAt            DateTime?
  conversionTrigger      String?
  location               Json?
  appVersion             String?
  referralSource         String?
  utmParams              Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime
  expiresAt              DateTime

  @@index([convertedToUserId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([lastActiveAt])
  @@index([sessionToken])
}

model api_keys {
  id         String    @id
  key        String    @unique
  name       String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime

  @@index([isActive])
  @@index([key])
}

model authentication_gates {
  id              String    @id
  sessionToken    String?
  userId          String?
  gateType        String
  gateTrigger     String
  gateLocation    String
  didAuthenticate Boolean   @default(false)
  authenticatedAt DateTime?
  didConvert      Boolean   @default(false)
  contentType     String?
  contentId       String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@index([didAuthenticate])
  @@index([gateType])
  @@index([sessionToken])
  @@index([userId])
}

model availability_windows {
  id           String    @id
  trainerId    String
  dayOfWeek    Int
  startTime    String
  endTime      String
  isRecurring  Boolean   @default(true)
  startDate    DateTime?
  endDate      DateTime?
  maxSessions  Int       @default(8)
  bufferMins   Int       @default(15)
  isOverride   Boolean   @default(false)
  overrideDate DateTime?
  isActive     Boolean   @default(true)
  label        String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([dayOfWeek])
  @@index([isActive])
  @@index([trainerId])
}

model blocked_users {
  id            String   @id
  userId        String
  blockedUserId String
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([userId, blockedUserId])
  @@index([blockedUserId])
  @@index([userId])
}

model booking_waitlist {
  id              String    @id
  trainerId       String
  playerId        String
  desiredDate     DateTime?
  desiredTimeSlot String?
  sessionType     String?
  duration        Int       @default(60)
  status          String    @default("active")
  priority        Int       @default(0)
  notifiedAt      DateTime?
  bookedAt        DateTime?
  expiresAt       DateTime?
  playerEmail     String
  playerPhone     String?
  notifyViaSMS    Boolean   @default(false)
  notifyViaEmail  Boolean   @default(true)
  notifyViaPush   Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime

  @@index([createdAt])
  @@index([playerId])
  @@index([priority])
  @@index([status])
  @@index([trainerId])
}

model check_in_templates {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  trainer_id String
  name       String
  type       String
  questions  Json
  schedule   String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  @@index([trainer_id], map: "idx_checkin_templates_trainer")
}

model check_ins {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  template_id   String
  client_id     String
  scheduled_for DateTime  @db.Timestamp(6)
  completed_at  DateTime? @db.Timestamp(6)
  responses     Json?
  status        String    @default("pending")
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)

  @@index([client_id], map: "idx_checkins_client")
  @@index([scheduled_for], map: "idx_checkins_scheduled")
  @@index([status], map: "idx_checkins_status")
  @@index([template_id], map: "idx_checkins_template")
}

model client_health_scores {
  id                      String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  client_id               String
  trainer_id              String
  health_score            Int
  attendance_rate         Decimal? @db.Decimal(5, 2)
  check_in_rate           Decimal? @db.Decimal(5, 2)
  response_time_hours     Decimal? @db.Decimal(10, 2)
  days_since_last_session Int?
  churn_risk              String?
  last_calculated_at      DateTime @db.Timestamp(6)
  created_at              DateTime @default(now()) @db.Timestamp(6)
  updated_at              DateTime @default(now()) @db.Timestamp(6)

  @@unique([client_id, trainer_id])
  @@index([client_id], map: "idx_health_scores_client")
  @@index([churn_risk], map: "idx_health_scores_risk")
  @@index([trainer_id], map: "idx_health_scores_trainer")
}

model client_packages {
  id                     String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  client_id              String
  package_id             String
  sessions_total         Int
  sessions_used          Int       @default(0)
  purchased_at           DateTime  @default(now()) @db.Timestamp(6)
  expires_at             DateTime? @db.Timestamp(6)
  is_active              Boolean   @default(true)
  stripe_subscription_id String?
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime  @default(now()) @db.Timestamp(6)

  @@index([client_id], map: "idx_client_packages_client")
  @@index([package_id], map: "idx_client_packages_package")
}

model clients {
  id               String             @id
  name             String
  email            String?
  phone            String?
  age              Int?
  goals            String[]
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  trainerId        String
  // Enhanced client intelligence for GIA
  sport            String?            // Primary sport (pickleball, tennis, yoga, etc.)
  skillLevel       String?            // beginner, intermediate, advanced
  injuries         String[]           @default([]) // Current injuries/limitations
  preferences      String[]           @default([]) // Likes/dislikes
  progress         Json?              // Track milestones and progress
  lastSessionDate  DateTime?          // Last time they trained
  sessionsCount    Int                @default(0)
  
  users            users              @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  payments         payments[]
  trainer_sessions trainer_sessions[]
}

model content_features {
  id              String    @id
  contentType     String
  contentId       String
  workoutType     String?
  intensity       String?
  duration        Int?
  specialty       String[]
  equipment       String[]
  trainerId       String?
  trainerStyle    String?
  location        Json?
  viewCount       Int       @default(0)
  likeCount       Int       @default(0)
  bookingCount    Int       @default(0)
  shareCount      Int       @default(0)
  completionRate  Float     @default(0)
  engagementScore Float     @default(0)
  rating          Float     @default(0)
  publishedAt     DateTime?
  lastUpdated     DateTime  @default(now())
  tags            String[]
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime

  @@unique([contentType, contentId])
  @@index([contentType])
  @@index([engagementScore])
  @@index([intensity])
  @@index([publishedAt])
  @@index([trainerId])
  @@index([workoutType])
}

model currency_rates {
  id           String   @id
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(18, 6)
  source       String   @default("api")
  validFrom    DateTime @default(now())
  validUntil   DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@unique([fromCurrency, toCurrency, validFrom])
  @@index([fromCurrency, toCurrency])
  @@index([isActive])
}

model email_logs {
  id             String    @id
  emailType      String
  recipientEmail String
  subject        String?
  status         String    @default("pending")
  metadata       Json?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([createdAt])
  @@index([emailType])
  @@index([recipientEmail])
  @@index([status])
}

model exercise_videos {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  trainer_id    String
  title         String
  description   String?
  video_url     String
  thumbnail_url String?
  duration      Int?
  category      String?
  tags          String[]
  specialty     String?
  difficulty    String?
  equipment     String[]
  view_count    Int      @default(0)
  is_public     Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @db.Timestamp(6)

  @@index([specialty], map: "idx_videos_specialty")
  @@index([trainer_id], map: "idx_videos_trainer")
}

model exercises {
  id                String   @id
  name              String   @unique
  description       String
  category          String
  muscleGroups      String[]
  equipment         String[]
  difficulty        String
  instructions      String
  tips              String?
  videoUrl          String?
  imageUrl          String?
  caloriesPerMinute Float?
  popularityScore   Float    @default(0)
  variations        Json?
  contraindications String[]
  substitutes       String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([category])
  @@index([difficulty])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model facilities {
  id           String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  sport        String
  type         String?
  category     String                    @default("rec")
  latitude     Float
  longitude    Float
  address      String?
  city         String?
  state        String?
  country      String?
  postal_code  String?
  phone        String?
  website      String?
  email        String?
  description  String?
  amenities    Json?                     @default("[]")
  surface_type String?
  court_count  Int?
  indoor       Boolean?                  @default(false)
  is_public    Boolean?                  @default(true)
  hours        Json?
  rating       Float?
  review_count Int?                      @default(0)
  source       String
  source_id    String
  source_url   String?
  metadata     Json?                     @default("{}")
  created_at   DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?                 @default(now()) @db.Timestamptz(6)
  geo_point    Unsupported("geography")?

  @@unique([source, source_id])
  @@index([category], map: "idx_facilities_category")
  @@index([city], map: "idx_facilities_city")
  @@index([geo_point], map: "idx_facilities_geo_point", type: Gist)
  @@index([source, source_id], map: "idx_facilities_source")
  @@index([sport], map: "idx_facilities_sport")
  @@index([sport, category], map: "idx_facilities_sport_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model facility_data_quality {
  id                String    @id
  facility_id       String
  date              DateTime  @db.Date
  total_checkins    Int?      @default(0)
  verified_checkins Int?      @default(0)
  avg_confidence    Decimal?  @default(0.00) @db.Decimal(3, 2)
  avg_gps_accuracy  Decimal?  @db.Decimal(10, 2)
  overall_quality   String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([facility_id, date])
  @@index([date(sort: Desc)], map: "idx_facility_data_quality_date")
  @@index([facility_id], map: "idx_facility_data_quality_facility")
  @@index([overall_quality], map: "idx_facility_data_quality_overall")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model facility_reports {
  id                     String   @id
  userId                 String
  facilityId             String
  sport                  String
  specificLocation       String?
  crowdLevel             String?
  skillLevel             String?
  ageGroup               String?
  weatherCondition       String?
  surfaceCondition       String?
  waitTime               Int?
  parkingAvailability    String?
  notes                  String?
  photos                 String[]
  videos                 String[]
  helpfulVotes           Int      @default(0)
  notHelpfulVotes        Int      @default(0)
  confirmations          Int      @default(0)
  rewardAmount           Float    @default(0)
  bonusAmount            Float    @default(0)
  streakMultiplier       Float    @default(1.0)
  reportQuality          Int?
  isVerified             Boolean  @default(false)
  gpsLat                 Float?
  gpsLng                 Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  latitude               Decimal? @db.Decimal(10, 8)
  longitude              Decimal? @db.Decimal(11, 8)
  gps_accuracy           Decimal? @db.Decimal(10, 2)
  device_type            String?
  app_version            String?
  is_verified            Boolean? @default(false)
  confidence_score       Decimal? @default(0.50) @db.Decimal(3, 2)
  quality_warnings       Json?    @default("[]")
  distance_from_facility Decimal? @db.Decimal(10, 2)

  @@index([createdAt])
  @@index([facilityId])
  @@index([sport])
  @@index([userId])
}

model facility_sport_mappings {
  id           Int       @id @default(autoincrement())
  sport        String    @unique
  display_name String
  osm_tags     Json?
  google_types Json?
  category     String    @default("rec")
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([category], map: "idx_facility_sport_mappings_category")
  @@index([sport], map: "idx_facility_sport_mappings_sport")
}

model feed_sessions {
  id               String    @id
  userId           String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  duration         Int?
  contentServed    Int       @default(0)
  contentViewed    Int       @default(0)
  contentLiked     Int       @default(0)
  contentSkipped   Int       @default(0)
  contentBooked    Int       @default(0)
  algorithmVersion String    @default("v1")
  avgTimePerItem   Float?
  skipRate         Float?
  engagementRate   Float?
  deviceType       String?
  appVersion       String?
  createdAt        DateTime  @default(now())

  @@index([algorithmVersion])
  @@index([startedAt])
  @@index([userId])
}

model gia_content {
  id               String   @id
  userId           String
  contentType      String
  prompt           String
  generatedContent Json
  usageCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@index([contentType])
  @@index([userId])
}

model group_class_bookings {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  class_id     String
  client_id    String
  status       String    @default("confirmed")
  booked_at    DateTime  @default(now()) @db.Timestamp(6)
  cancelled_at DateTime? @db.Timestamp(6)
  attended_at  DateTime? @db.Timestamp(6)
  payment_id   String?
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @db.Timestamp(6)

  @@index([class_id], map: "idx_group_class_bookings_class")
  @@index([client_id], map: "idx_group_class_bookings_client")
}

model group_classes {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  trainer_id        String
  name              String
  description       String?
  max_capacity      Int
  current_bookings  Int      @default(0)
  price_per_person  Decimal  @db.Decimal(10, 2)
  scheduled_at      DateTime @db.Timestamp(6)
  duration          Int
  location          String?
  is_recurring      Boolean  @default(false)
  recurring_pattern String?
  status            String   @default("scheduled")
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @default(now()) @db.Timestamp(6)
}

model leaderboard_snapshots {
  id          String    @id
  period      String
  periodStart DateTime  @db.Date
  periodEnd   DateTime? @db.Date
  rankings    Json
  createdAt   DateTime  @default(now())

  @@index([periodStart])
  @@index([period])
}

model maintenance_categories {
  id           String   @id
  sport        String
  category     String
  displayName  String
  icon         String
  commonIssues String[]
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)

  @@index([sport])
}

model maintenance_reports {
  id               String    @id
  userId           String
  facilityId       String
  sport            String
  specificLocation String?
  category         String
  issue            String
  severity         String
  description      String?
  photos           String[]
  videos           String[]
  status           String    @default("reported")
  acknowledgedAt   DateTime?
  inProgressAt     DateTime?
  fixedAt          DateTime?
  verifiedAt       DateTime?
  confirmations    Int       @default(0)
  helpfulVotes     Int       @default(0)
  rewardAmount     Float     @default(0)
  bonusAmount      Float     @default(0)
  facilityNotes    String?
  estimatedFixDate DateTime?
  actualCost       Float?
  fixDuration      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime

  @@index([createdAt])
  @@index([facilityId])
  @@index([severity])
  @@index([status])
  @@index([userId])
}

model messages {
  id                               String      @id
  senderId                         String
  receiverId                       String
  content                          String
  messageType                      MessageType @default(TEXT)
  read                             Boolean     @default(false)
  readAt                           DateTime?
  sessionId                        String?
  createdAt                        DateTime    @default(now())
  updatedAt                        DateTime
  users_messages_receiverIdTousers users       @relation("messages_receiverIdTousers", fields: [receiverId], references: [id], onDelete: Cascade)
  users_messages_senderIdTousers   users       @relation("messages_senderIdTousers", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([receiverId])
  @@index([senderId])
  @@index([sessionId])
}

model moderation_actions {
  id            String   @id
  moderatorId   String
  moderatorName String
  actionType    String
  targetType    String
  targetId      String
